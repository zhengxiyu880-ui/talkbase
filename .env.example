# 模型配置：任何 OpenAI 兼容服务都行，留空则进入「演示模式」
# 例：
#   DeepSeek  OPENAI_BASE_URL=https://api.deepseek.com  OPENAI_MODEL=deepseek-chat
#   通义千问  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
#   OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 数据文件位置（默认 ./data/db.json）
TALKBASE_DB=
